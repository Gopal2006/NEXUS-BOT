---
import { INVITE_URL, isTodo } from "../config";
const { compact = false } = Astro.props;
const todo = isTodo(INVITE_URL);
---
<a
  class:list={["button", "button-primary", { "button-compact": compact }]}
  href={todo ? "#invite-not-configured" : INVITE_URL}
  data-todo={todo ? "invite" : undefined}
>
  <span>Add to Discord</span>
  <svg aria-hidden="true" viewBox="0 0 20 20" width="17" height="17" fill="none">
    <path d="M4 10h11M10 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
