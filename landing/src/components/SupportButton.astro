---
import { SUPPORT_URL, isTodo } from "../config";
const { secondary = false } = Astro.props;
const todo = isTodo(SUPPORT_URL);
---
<a
  class:list={["button", secondary ? "button-secondary" : "button-primary"]}
  href={todo ? "#support-link-not-configured" : SUPPORT_URL}
  data-todo={todo ? "support" : undefined}
  target={todo ? undefined : "_blank"}
  rel={todo ? undefined : "noreferrer"}
>
  Join Support Server
  <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none"><path d="M4 10h11M10 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
</a>
