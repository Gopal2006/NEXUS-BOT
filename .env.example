# ==========================================
# Nexus Discord Bot — Environment Variables
# ==========================================

# Discord Bot Token (Required)
BOT_TOKEN=your_bot_token_here

# Brand identity
BRAND_NAME=Nexus
SUPPORT_SERVER=https://discord.gg/your_support_server

# Bot Owners (comma-separated list of Discord User IDs)
# Replaces hardcoded GLOBAL_OWNER_ID
OWNER_IDS=1201050377911554061

# SQLite Database Path
DATABASE_PATH=nexus.db

# Privileged Gateway Intents
ENABLE_PRESENCE_INTENT=false

# Deployment Port (set automatically by cloud hosts like Render)
PORT=8000

# ==========================================
# Dashboard API (FastAPI In-Process Server)
# ==========================================
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_API_KEY=change_me_to_a_long_random_string_for_security
CORS_ORIGINS=http://localhost:3000

# Optional Cloudflare Tunnel
TUNNEL_ENABLED=false
CF_TUNNEL_TOKEN=
CF_TUNNEL_URL=
